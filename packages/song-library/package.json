  "description": "Built-in library of beginner piano pieces (public domain), authored in a compact text notation and compiled to the canonical Score model or to MusicXML.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
